# Copie para .env e ajuste. Nunca commite o .env.
# Em dev, o docker-compose já define DATABASE_URL e REDIS_URL apontando para os containers.

# --- Aplicação ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173 # origem permitida no CORS e base dos links nos e-mails

# --- Banco e Redis (para rodar fora do Docker) ---
DATABASE_URL=postgresql+asyncpg://tirei:tirei@localhost:5432/tirei_voce
REDIS_URL=redis://localhost:6379/0

# --- Sessão / segurança ---
JWT_SECRET=troque-por-um-valor-aleatorio-de-32+-caracteres  # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true                 # false só em dev (http)
COOKIE_DOMAIN=                     # vazio = domínio atual

# --- Sigilo do sorteio (gere com: make keys) ---
# Trocar estas chaves depois de um sorteio torna os resultados antigos ilegíveis.
DRAW_ENCRYPTION_KEY=               # chave Fernet (base64 de 32 bytes)
DRAW_HMAC_KEY=                     # 32+ caracteres aleatórios

# --- Notificações push (opcional; gere com: make keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@tireivoce.com.br

# --- Login com Google (opcional; sem isso o botão fica desabilitado) ---
# Console: https://console.cloud.google.com/apis/credentials (OAuth client "Web application")
# Authorized redirect URI: o mesmo valor de GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# --- E-mail ---
EMAIL_PROVIDER=console             # console (dev: o link aparece no log do worker) | resend
EMAIL_FROM="Tirei Você! <nao-responda@tireivoce.com.br>"
RESEND_API_KEY=
VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_MINUTES=60

# --- Observabilidade (opcional) ---
SENTRY_DSN=                        # vazio = Sentry desligado
SENTRY_TRACES_SAMPLE_RATE=0.0
